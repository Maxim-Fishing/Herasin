rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['correo.administradora@gmail.com'];
    }

    // Lectura pública (catálogo); escritura solo de la administradora.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
